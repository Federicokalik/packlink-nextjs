# --- Packlink PRO ------------------------------------------------------------
# API key of your Packlink PRO account. Server only: never NEXT_PUBLIC_.
PACKLINK_API_KEY=
# Optional: another API host, e.g. a sandbox Packlink gave you.
PACKLINK_API_BASE_URL=
# Currency of the declared content value (default EUR).
PACKLINK_CURRENCY=

# Sender (your warehouse). ZIP and COUNTRY are enough to quote; the full
# address is needed to create shipments.
PACKLINK_FROM_NAME=
PACKLINK_FROM_SURNAME=
PACKLINK_FROM_COMPANY=
PACKLINK_FROM_STREET=
PACKLINK_FROM_STREET2=
PACKLINK_FROM_CITY=
PACKLINK_FROM_ZIP=
PACKLINK_FROM_STATE=
PACKLINK_FROM_COUNTRY=IT
PACKLINK_FROM_PHONE=
PACKLINK_FROM_EMAIL=

# Shared with the scheduler that calls /api/jobs/packlink-sync.
# On Vercel Cron, set CRON_SECRET instead and pass it to createSyncRoute.
PACKLINK_SYNC_CRON_SECRET=

# --- Database used by the example ---------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
